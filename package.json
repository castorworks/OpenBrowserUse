{
  "name": "open-browser-use",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "mcp": "node bin/mcp.js",
    "test": "node --test test/*.test.js",
    "test:desktop": "node --test test/desktop.integration.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "release:mac": "node scripts/release-mac.mjs",
    "icons": "node scripts/build-icons.mjs",
    "api": "node bin/server.js",
    "start:service": "node --env-file-if-exists=.env bin/server.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "playwright": "^1.56.0",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "bin": {
    "openbrowseruse": "bin/mcp.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "main": "desktop/main.cjs",
  "description": "Local AI browser agent with an Electron workbench and Chrome extension support",
  "author": "CastorWorks",
  "build": {
    "appId": "com.castorworks.openbrowseruse",
    "productName": "Open Browser Use",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "docs/openapi.json",
      "bin/**/*",
      "package.json",
      "assets/**/*",
      "!assets/icons/*concept*.png"
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**/*",
      "node_modules/playwright/**/*"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
