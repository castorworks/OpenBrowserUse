{
  "manifest_version": 3,
  "name": "Open Browser Use",
  "version": "0.2.0",
  "description": "Let the Open Browser Use agent work in your Chrome, in its own tab group, with your logins.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "sidePanel", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Browser Use", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
